# ==========================================
# AWS Credentials & Region
# ==========================================
export AWS_ACCESS_KEY_ID="<YOUR_AWS_ACCESS_KEY_ID>"
export AWS_SECRET_ACCESS_KEY="<YOUR_AWS_SECRET_ACCESS_KEY>"
export AWS_DEFAULT_REGION="us-east-1"

export TF_VAR_aws_access_key="${AWS_ACCESS_KEY_ID}"
export TF_VAR_aws_secret_key="${AWS_SECRET_ACCESS_KEY}"
export TF_VAR_aws_region="${AWS_DEFAULT_REGION}"

# ==========================================
# Service Passwords & Tokens
# ==========================================
export TF_VAR_grafana_password="<YOUR_STRONG_GRAFANA_PASSWORD>"
export TF_VAR_huggingface_token="<YOUR_HUGGINGFACE_READ_TOKEN>"

# ==========================================
# Demo End-User Credentials
# ==========================================
export TF_VAR_demo_user_email="<YOUR_DEMO_USER_EMAIL>"
export TF_VAR_demo_user_password="<YOUR_DEMO_USER_PASSWORD>"